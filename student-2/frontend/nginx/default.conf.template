server {
    listen 80;

    # API routes proxied to student-2 backend (same-origin, no hardcoded host/port)
    location ~ ^/(accounts|health|ask|ask-with-context|mcp|rag|multi-agent|auth)(/|$) {
        proxy_pass ${BACKEND_SERVICE_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Multi-Agent and RAG answers can wait on Ollama for minutes
        proxy_read_timeout 300s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
