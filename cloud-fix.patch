diff --git a/student-4/frontend/default.conf.template b/student-4/frontend/default.conf.template
new file mode 100644
index 0000000..b39ea0c
--- /dev/null
+++ b/student-4/frontend/default.conf.template
@@ -0,0 +1,25 @@
+# Same-origin proxy (same pattern as student-5/frontend/default.conf.template).
+# The browser only talks to this frontend; nginx forwards API paths to the backend.
+# BACKEND_URL is filled in at container start by the nginx image (envsubst):
+#   local (Compose): set in this folder's Dockerfile
+#   cloud (Azure):   https://<backend internal FQDN>, set by scripts/clouddeployment/deploy-azure.sh
+server {
+    listen 80;
+
+    # API routes proxied to student-4 backend
+    location ~ ^/(users)(/|$) {
+        proxy_pass ${BACKEND_URL};
+        proxy_ssl_server_name on;
+        proxy_set_header Host $proxy_host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 300s;
+    }
+
+    location / {
+        root /usr/share/nginx/html;
+        index index.html;
+        try_files $uri $uri/ /index.html;
+    }
+}
